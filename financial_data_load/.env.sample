# =============================================================================
# Neo4j Connection
# =============================================================================
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# =============================================================================
# AWS Bedrock
#   Auth: standard boto3 credential chain (~/.aws/credentials, env vars, IAM role)
#   MODEL_ID is optional — default shown below.
# =============================================================================
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-6

# --- Embedding model ---
# Amazon Titan Text Embeddings V2 (1024 dims to match existing vector indexes)
EMBEDDING_DIMENSIONS=1024

# =============================================================================
# MCP Gateway (Labs 4, 7)
# =============================================================================
MCP_GATEWAY_URL=
MCP_ACCESS_TOKEN=

